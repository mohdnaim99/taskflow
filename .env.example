# Salin ke .env (Copy-Item .env.example .env) dan tukar nilai.
# .env diabaikan oleh Git. Jangan commit rahsia sebenar.

# --- PostgreSQL ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
# Guna huruf dan nombor sahaja (aksara ; atau = merosakkan connection string)
POSTGRES_PASSWORD=change-me-db-password

# --- Backend ---
# Minimum 32 aksara. Jana: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
# User demo (dibenarkan oleh brief)
ADMIN_EMAIL=admin@taskflow.com
ADMIN_PASSWORD=Admin@123

# --- Port pada hos ---
FRONTEND_PORT=4200
BACKEND_PORT=8080
